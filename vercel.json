{
  "version": 2,
  "builds": [
    { "src": "api/app.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/app.py" },
    { "src": "/(.*)", "dest": "public/index.html" }
  ],
  "functions": {
    "api/app.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
